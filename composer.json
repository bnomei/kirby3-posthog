{
    "name": "bnomei/kirby3-posthog",
    "license": "MIT",
    "description": "Kirby Plugin for interfacing with Posthog",
    "type": "kirby-plugin",
    "version": "6.0.0",
    "authors": [
        {
            "name": "Bruno Meilick",
            "email": "b@bnomei.com"
        }
    ],
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "posthog",
        "analytics"
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Bnomei\\": "classes/"
        }
    },
    "require": {
        "php": ">=8.3",
        "getkirby/composer-installer": "^1.2",
        "posthog/posthog-php": "^4.27.1"
    },
    "require-dev": {
        "getkirby/cms": "^6.0",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^v3.5.1",
        "phpstan/phpstan": "^2.1",
        "spatie/ray": "^1.39"
    },
    "scripts": {
        "stan": "./vendor/bin/phpstan",
        "fix": "./vendor/bin/pint",
        "test": "./vendor/bin/pest --profile",
        "dist": [
            "composer fix",
            "composer install --no-dev --optimize-autoloader",
            "git rm -rf --cached .; git add .;"
        ],
        "kirby": "@composer install"
    },
    "extra": {
        "kirby-cms-path": "tests/kirby",
        "kirby": {"compatible": "^6.0"}
    }
}
